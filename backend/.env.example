# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/notifica-ai

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=substitua_por_uma_string_longa_e_aleatoria

# ── E-mail (Resend) ────────────────────────────────────────
# Crie uma conta gratuita em https://resend.com (3.000 e-mails/mês)
# e gere uma API Key no painel (resend.com/api-keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Endereço de envio verificado no Resend.
# Domínio notifica.dev.br já verificado — use qualquer prefixo abaixo:
#   noreply@notifica.dev.br  (padrão recomendado)
#   alerta@notifica.dev.br
#   contato@notifica.dev.br
EMAIL_REMETENTE=noreply@notifica.dev.br

# ── URLs ───────────────────────────────────────────────────
# URL pública do backend (usada em links de cancelamento de alerta)
BASE_URL=https://notifica.dev.br

# URL pública do frontend (para onde o Mercado Pago devolve o usuário após o checkout)
FRONTEND_URL=https://notifica.dev.br

# ── Planos ─────────────────────────────────────────────────
# Frequência de checagem do plano gratuito, em horas (6, 12 ou 24). Padrão: 6.
FREE_INTERVALO_HORAS=6
# Dias do teste grátis do Pro (uma vez por conta, exige e-mail confirmado). Padrão: 7.
TESTE_GRATIS_DIAS=7

# ── Mercado Pago (assinatura Pro) ──────────────────────────
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE até validar o fluxo completo.
MP_ACCESS_TOKEN=cole_aqui_o_access_token
# Segredo do webhook (Suas integrações → Webhooks → "Assinatura secreta").
# URL do webhook: <BASE_URL>/api/webhooks/mercadopago — eventos "Planos e assinaturas" e "Pagamentos".
MP_WEBHOOK_SECRET=
# Chave pública (mesma tela das credenciais) — usada pelo formulário de cartão
MP_PUBLIC_KEY=cole_aqui_a_public_key
# Valor mensal do Pro em reais (assinatura no cartão)
MP_PRECO_MENSAL=14.90
# Pix avulso (opcionais): padrão = 1 mês pelo preço mensal; anual = 10 meses
MP_PRECO_PIX_30_DIAS=
MP_PRECO_PIX_ANUAL=

# ── IA (resumo de mudanças — plano Pro) ────────────────────
# Chave em https://aistudio.google.com/apikey. Sem chave, os alertas
# continuam funcionando com o aviso genérico de mudança.
GEMINI_API_KEY=
# Modelo usado nos resumos
GEMINI_MODEL=gemini-2.5-flash
# Trava de custo: máximo de resumos por dia (por instância do backend)
IA_LIMITE_DIARIO=2000

# ── Radar do Diário Oficial ───────────────────────────────
# Chave de 32 bytes (base64) para cifrar nomes/CPF/inscrições no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: guarde-a bem — se for perdida, os dados cifrados não podem ser lidos.
DADOS_CHAVE=
# Máximo de nomes por usuário Pro
RADAR_MAX_NOMES=2
# Cidades disponíveis (códigos IBGE separados por vírgula). Vazio = todas.
# Rio=3304557 Niterói=3303302 São Gonçalo=3304904 Duque de Caxias=3301702
# Nova Iguaçu=3303500 Maricá=3302700. Ex.: lançar só com o Rio → RADAR_CIDADES=3304557
RADAR_CIDADES=

# ── Telegram (alertas no Telegram — plano Pro) ────────────
# Crie o bot com o @BotFather no Telegram (/newbot): ele devolve o token.
TELEGRAM_BOT_TOKEN=
# Nome de usuário do bot, sem @ (ex.: NotificaAiBot)
TELEGRAM_BOT_USERNAME=
# Qualquer texto aleatório longo (só letras, números, _ e -): protege o webhook
TELEGRAM_WEBHOOK_SECRET=

# ── CORS ───────────────────────────────────────────────────
# Lista separada por vírgula das origens permitidas pelo CORS.
CORS_ORIGINS=https://notifica.dev.br,http://localhost:5173
